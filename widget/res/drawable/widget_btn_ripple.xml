<!--  ВАЖНО: у item обязателен android:id="@android:id/mask" — без него
     Android рисует эту фигуру как постоянный видимый слой (а не только
     как маску для подсветки при нажатии), и она перекрывает сплошным
     белым цветом всё содержимое кнопки. Именно это и вызвало баг с
     белыми плашками вместо кнопок.  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3DFFFFFF">
<item android:id="@android:id/mask">
<shape android:shape="rectangle">
<solid android:color="@android:color/white"/>
<corners android:radius="19dp"/>
</shape>
</item>
</ripple>
