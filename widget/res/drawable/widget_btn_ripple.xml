<?xml version="1.0" encoding="utf-8"?>
<!-- Подсветка нажатия для кнопок: маска — скруглённый прямоугольник,
     примерно повторяющий форму, нарисованную в Bitmap внутри кнопки.
     Без этой маски системная подсветка рисуется прямоугольником на всю
     ячейку и вылезает за пределы видимой кнопки. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3DFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</ripple>
