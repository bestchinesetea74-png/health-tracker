<!--  Тот же фикс: shape помечена как android:id="@android:id/mask", иначе
     она рисуется постоянно и перекрывает капсулу сплошной белой заливкой.  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3DFFFFFF">
<item android:id="@android:id/mask">
<shape android:shape="rectangle">
<solid android:color="@android:color/white"/>
<corners android:radius="200dp"/>
</shape>
</item>
</ripple>
