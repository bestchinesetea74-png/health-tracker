<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_shape" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/water_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="0 / 2000"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/glass_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="мл, стакан 250"
                android:textColor="#BBBBBB"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitXY" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_glass_minus"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:layout_marginLeft="3dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/btn_glass_minus_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_btn_shape" />

            <TextView
                android:id="@+id/btn_glass_minus_txt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="−50"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_glass_plus"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:layout_marginLeft="3dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/btn_glass_plus_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_btn_shape" />

            <TextView
                android:id="@+id/btn_glass_plus_txt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+50"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_water_minus"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/btn_water_minus_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_btn_shape" />

            <TextView
                android:id="@+id/btn_water_minus_txt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="−250"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_water_plus"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:layout_marginLeft="3dp"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/btn_water_plus_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_btn_shape" />

            <TextView
                android:id="@+id/btn_water_plus_txt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+250"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
